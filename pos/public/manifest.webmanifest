{
  "name": "Al-rehman POS",
  "short_name": "AlrehmanPOS",
  "description": "Offline-capable Point of Sale for Al-rehman Fast Food",
  "start_url": "/orders/new",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#050505",
  "theme_color": "#f97316",
  "orientation": "any",
  "categories": ["business", "food"],
  "icons": [
    {
      "src": "/logo.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "New Order",
      "short_name": "Order",
      "url": "/orders/new"
    },
    {
      "name": "Pending Orders",
      "short_name": "Pending",
      "url": "/orders/pending"
    }
  ]
}
