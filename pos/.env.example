# Copy to .env.local.
#
# Local Next.js development against a local Go API:
# NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
#
# Shop / production-local POS (Phase 1 Setup-Local-POS.bat) must use the
# deployed cloud API, for example:
# NEXT_PUBLIC_API_URL=https://YOUR-API.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://YOUR-API.onrender.com/api/v1
NEXT_PUBLIC_APP_NAME=Musa Cafe POS
