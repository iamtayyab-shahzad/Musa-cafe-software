# Root hygiene for the monorepo. App-specific ignores also live under
# admin/, website/, pos/, and backend/.

# Dependencies / build
node_modules/
.next/
out/
dist/
build/
coverage/
.turbo/
.vercel/

# Env & secrets
.env
.env.*
!.env.example
!**/.env.example

# Logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
debug-*.log
.cursor/debug-*.log

# OS / editor
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/*
!.vscode/extensions.json

# Local tooling / scratch
.sharp-tmp/
*.tgz
sharp-*.tgz

# Go
backend/tmp/
*.exe
*.test

# TypeScript
*.tsbuildinfo
next-env.d.ts
