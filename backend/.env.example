APP_ENV=development
# Local: APP_PORT. Cloud (Render/Railway/Fly): they set PORT automatically.
APP_PORT=8080
# Prefer DATABASE_URL on cloud (Neon/Supabase). Or set discrete DB_* below.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-local-db-password
DB_NAME=musacafe
# Local: disable | Cloud Neon/Supabase: require
DB_SSLMODE=disable
JWT_SECRET=replace-with-a-strong-secret-min-16-chars
# Shop identity (shared/shop.json is the source of truth; env overrides if set)
SHOP_NAME=Musa Cafe
ORDER_PREFIX=MC
SITE_URL=http://localhost:3000
WHATSAPP_OWNER_PHONE=
# Image hosting — required for staff photo uploads (product records store the URL only).
# Copy these into backend/.env.local with real values. Never commit real keys.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
